VITE_RGPP_INTAKE_ENDPOINT=
VITE_GOOGLE_MAPS_API_KEY=

# Public tracking is administered by admin@bradsdadsland.com. The site installs
# GTM-N5S4SZS8 and the GA4 Google tag for G-5714F7Y7QK directly in index.html.
# Do not also publish a GA4 configuration tag for this measurement ID in GTM.

# Brad's reporting sources. GA4's numeric property ID is not the measurement ID:
# set the dataset created by the native GA4 BigQuery link.
BRADS_GCP_PROJECT=focused-clock-498319-f5
BRADS_REPORTING_DATASET=bradsdadsland_reporting
BRADS_SERVING_DATASET=bradsdadsland_dashboard
BRADS_GA4_DATASET=
BRADS_SEARCH_CONSOLE_DATASET=searchconsole_bradsdadsland
BRADS_BIGQUERY_LOCATION=US

# Campspot report validation. Property 1514 is the discovered Brad boundary and
# must still be confirmed in Campspot administration before activation. Gmail
# is read-only and delegated only to admin@beachcomberrv.com.
BRADS_CAMPSPOT_PROPERTY_ID=1514
# Set true only after every available season/report is reconciled and the exact
# campground + vintage-trailer map is reviewed. Required to enable Scheduler.
BRADS_CAMPSPOT_ACTIVATION_APPROVED=false
CAMPSPOT_EXPECTED_RECIPIENT=data-ingest-bradsdadsland@beachcomberrv.com
# Optional defense-in-depth only. Leave empty unless Campspot/Google Groups
# reliably preserves the chosen prefix; recipient and property ID stay required.
CAMPSPOT_SUBJECT_PREFIX=
# Optional local-import mirror; if set during managed deployment it must exactly
# match BRADS_CAMPSPOT_PROPERTY_ID.
CAMPSPOT_EXPECTED_PARK_ID=1514
CAMPSPOT_EXPECTED_PARK_NAME=Brad's Dads Land
CAMPSPOT_INVENTORY_MAP_PATH=config/dashboard/campspot-inventory-map.json
GOOGLE_WORKSPACE_DELEGATED_USER=admin@beachcomberrv.com
# Optional local-only OAuth bootstrap path for manual mailbox/Group inspection.
# It must be supplied explicitly and must not point at Beachcomber credentials.
BRADS_BOOTSTRAP_TOKEN_PATH=

# Idempotent Cloud Run Jobs/Scheduler deployment. These are identifiers, not
# credentials. See infra/dashboard/README.md. us-west1 is the Cloud Run region;
# BigQuery and the state bucket remain in the US multi-region.
BRADS_DASHBOARD_GCP_PROJECT=focused-clock-498319-f5
BRADS_DASHBOARD_GCP_PROJECT_NUMBER=1074630920917
BRADS_DASHBOARD_GCP_REGION=us-west1
BRADS_DASHBOARD_BIGQUERY_LOCATION=US
BRADS_DASHBOARD_AR_REPOSITORY=brads-dashboard
BRADS_DASHBOARD_IMAGE_TAG=latest
BRADS_DASHBOARD_STATE_BUCKET=focused-clock-498319-f5-brads-dashboard-state
BRADS_DASHBOARD_MONITORING_EMAIL=admin@beachcomberrv.com

# Private dashboard server settings. Configure production values in the
# bradsdadsland Vercel project; never prefix secrets with VITE_.
DASHBOARD_PASSWORD_HASH=
DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_SECONDS=43200
DASHBOARD_ALLOWED_ORIGINS=https://bradsdadsland.com,https://www.bradsdadsland.com
DASHBOARD_GCP_PROJECT_NUMBER=1074630920917
DASHBOARD_GCP_SERVICE_ACCOUNT_EMAIL=bdl-dashboard-reader@focused-clock-498319-f5.iam.gserviceaccount.com
DASHBOARD_GCP_WORKLOAD_IDENTITY_POOL_ID=vercel-brads-dashboard
DASHBOARD_GCP_WORKLOAD_IDENTITY_PROVIDER_ID=vercel-brads-production
DASHBOARD_BIGQUERY_PROJECT_ID=focused-clock-498319-f5
DASHBOARD_BIGQUERY_DATASET_ID=bradsdadsland_dashboard
DASHBOARD_BIGQUERY_LOCATION=US
DASHBOARD_BIGQUERY_MAXIMUM_BYTES_BILLED=1000000000
# Optional local-only fallback. Production must leave this unset and use Vercel
# OIDC plus the exact production subject documented in dashboard-setup.md.
DASHBOARD_BIGQUERY_SERVICE_ACCOUNT_JSON=
