{
  "name": "bradsdadsland",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dashboard:campspot:ingest": "node scripts/campspot-email-ingest.mjs pull --load=true",
    "dashboard:deploy-jobs": "node infra/dashboard/deploy.mjs",
    "dashboard:deploy-schema": "node scripts/dashboard-reporting.mjs deploy",
    "dashboard:deploy-serving": "node scripts/dashboard-serving.mjs deploy",
    "dashboard:google-exports": "node scripts/google-managed-exports.mjs setup",
    "dashboard:google-exports:auth": "node scripts/google-managed-exports.mjs auth",
    "dashboard:inspect": "node scripts/dashboard-reporting.mjs inspect",
    "dashboard:password-hash": "node api/_lib/generate-password-hash.js",
    "dashboard:snapshot": "node scripts/dashboard-reporting.mjs snapshot",
    "dashboard:test": "node --test tests/dashboard-*.test.mjs tests/reporting-*.test.mjs tests/campspot-*.test.mjs tests/tracking-*.test.mjs tests/infra-*.test.mjs",
    "dashboard:validate": "node scripts/dashboard-reporting.mjs validate",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run dashboard:test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-router-dom": "^7.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^6.3.5"
  }
}
